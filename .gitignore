cat > .gitignore <<'EOF'
# Environment variables and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Rust
target/

# Go
/vendor/

# Node.js / React
node_modules/
dist/
build/
coverage/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
tmp/
temp/
EOF